# Store these values in your backend host's secret/environment settings.
# Never put provider API keys in Android source code.
GEMINI_API_KEY=replace_with_your_server_side_key
GEMINI_MODEL=gemini-2.5-flash
# Gemini native image generation model. Access/quota depends on your Google AI project.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
PORT=8080

# Generate a random 32+ character token and set the same value in the app's Backend Access Token field.
# When configured, all /api/chat and /api/image requests require Authorization: Bearer <token>.
MAXXA_CLIENT_TOKEN=replace_with_a_random_32_plus_character_token
# Set only when your hosting platform uses a known reverse-proxy hop count (usually 1).
TRUST_PROXY_HOPS=0
